# One2lvOS environment configuration
# Copy this file to .env (cp .env.example .env) and fill in your values.
# .env is git-ignored. Never commit real keys, tokens or passwords.

# ============================================================
# Application settings
# ============================================================
NODE_ENV=production
PORT=3000
UI_PORT=3000
AI_LOBBY_PORT=8787
CORE_API_PORT=3002
# Optional: force the project root (scripts auto-detect it otherwise)
ONE2LVOS_ROOT=

# ============================================================
# AI Lobby (ai-lobby/server.js)
# ============================================================
# Admin login. Leave the password empty and admin login stays disabled.
LOBBY_ADMIN_USER=
LOBBY_ADMIN_PASSWORD=

# ============================================================
# NVIDIA NIM keys
# ============================================================
# Main key, used by everything that has no model-specific key below
NVIDIA_API_KEY=
# Per-model keys for the AI Lobby (each falls back to NVIDIA_API_KEY)
NVIDIA_API_KEY_GEMMA=
NVIDIA_API_KEY_LLAMA=
NVIDIA_API_KEY_DEEPSEEK=
NVIDIA_API_KEY_NEMOTRON=
# Lumenis / MiniMax reactors
NVIDIA_API_KEY_MINIMAX=
NVIDIA_API_KEY_SECONDARY=
NVIDIA_API_KEY_NEMOTRON_SUPER=
NVIDIA_API_KEY_STEPFUN=
NVIDIA_API_KEY_KIMI=

# ============================================================
# Other model providers
# ============================================================
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# ============================================================
# Astra DB
# ============================================================
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_KEYSPACE=one2lvos
ASTRA_DB_COLLECTION=memory

# ============================================================
# Moltbook
# ============================================================
# Used by minimax/moltbook-registry/ROOT_MANIFEST.sh
MOLTBOOK_API_KEY=
# Used by lumenis_v7
MOLTBOOK_KEY_1=
MOLTBOOK_KEY_2=
MOLTBOOK_KEY_3=

# ============================================================
# Services and logins
# ============================================================
# JWT signing secret and admin password for the Delta / interplanetary-disk APIs
JWT_SECRET=
ADMIN_PASSWORD=
# FTP and WebDAV servers (a random one-time password is used if empty)
FTP_PASS=
WEBDAV_PASS=
# SSH server host key path (a new key is generated there if missing)
SSH_HOST_KEY=

# ============================================================
# Integrations
# ============================================================
MATON_API_KEY=
GITHUB_TOKEN=
DISCORD_BOT_TOKEN=
TWITCH_OAUTH_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ============================================================
# Logging and features
# ============================================================
LOG_LEVEL=info
LOG_FILE=./logs/one2lvos.log
ENABLE_VOICE_CONTROL=true
ENABLE_AI_COUNCIL=true
ENABLE_TELEMETRY=true
MAX_MEMORY_ITEMS=10000
CACHE_TTL=3600
REQUEST_TIMEOUT=30000
