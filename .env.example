# One2lvOS Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# Astra DB Configuration
# ============================================
ASTRA_DB_APPLICATION_TOKEN=your_astra_token_here
ASTRA_DB_API_ENDPOINT=https://your-database-id-region.apps.astra.datastax.com
ASTRA_DB_KEYSPACE=one2lvos
ASTRA_DB_COLLECTION=memory

# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# NVIDIA Configuration (Optional)
# ============================================
# NVIDIA_API_KEY=your_nvidia_api_key_here

# ============================================
# NASA API Configuration (Optional)
# ============================================
# NASA_API_KEY=your_nasa_api_key_here

# ============================================
# Service Ports
# ============================================
UI_PORT=3000
AI_LOBBY_PORT=8787
CORE_API_PORT=3002

# ============================================
# Security Settings
# ============================================
# JWT_SECRET=your_jwt_secret_here
# CORS_ORIGIN=https://your-domain.com

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
LOG_FILE=/app/logs/one2lvos.log

# ============================================
# Feature Flags
# ============================================
ENABLE_VOICE_CONTROL=true
ENABLE_AI_COUNCIL=true
ENABLE_TELEMETRY=true

# ============================================
# Performance Settings
# ============================================
MAX_MEMORY_ITEMS=10000
CACHE_TTL=3600
REQUEST_TIMEOUT=30000
