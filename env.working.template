# Lumenis Reactor — Environment Configuration Template
# Copy this file to .env and fill in your values.
#
# ── LLM Backend (pick ONE of the three options below) ────────────────────────
#
# Option A: Any OpenAI-compatible provider (OpenAI, OpenRouter, Groq, Together, etc.)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
#
# Option B: NVIDIA NIM (if you have a valid NVIDIA API key)
# LLM_API_KEY=nvapi-...
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.2-90b-vision-instruct
#
# Option C: AWS Bedrock (auto-detected in Maton sandbox — no config needed)
# AWS_BEARER_TOKEN_BEDROCK=  ← injected automatically by network policy
# BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6
#
# ─────────────────────────────────────────────────────────────────────────────

# ASTRA DB Configuration
ASTRA_DB_API_ENDPOINT=your_astra_db_endpoint_here
ASTRA_DB_APPLICATION_TOKEN=your_astra_db_token_here
ASTRA_DB_KEYSPACE=default_keyspace
COLLECTION_NAME=aria_memory

# Discord (Optional)
DISCORD_BOT_TOKEN=your_discord_token_here
DISCORD_WEBHOOK_URL=your_webhook_url_here

# Supabase (Optional)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_key_here

# Maton (Optional)
MATON_API_KEY=your_maton_key_here
