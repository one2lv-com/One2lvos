{
  "colors": {
    "primary": "#00A3FF",
    "secondary": "#6B7280",
    "accent": "#FFE36F",
    "background": "#FFFFFF",
    "text": "#1F2937",
    "error": "#DC2626",
    "warning": "#FFFDBD",
    "success": "#10B981",
    "info": "#FFF5D0"
  },
  "typography": {
    "primary_font": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "secondary_font": "'JetBrains Mono', 'Courier New', monospace",
    "monospace_font": "'JetBrains Mono', 'Courier New', monospace",
    "base_size": "16px",
    "scale_ratio": 1.25
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px"
  },
  "components": [
    {
      "name": "Primary Button",
      "type": "button",
      "css_class": ".lumenis-btn-primary",
      "background": "#00A3FF",
      "color": "#FFFFFF",
      "properties": {
        "padding": "8px 16px",
        "border-radius": "8px",
        "font-weight": "600",
        "border": "none",
        "cursor": "pointer",
        "transition": "all 0.2s"
      }
    },
    {
      "name": "Secondary Button",
      "type": "button",
      "css_class": ".lumenis-btn-secondary",
      "background": "transparent",
      "color": "#00A3FF",
      "properties": {
        "padding": "8px 16px",
        "border-radius": "8px",
        "font-weight": "600",
        "border": "2px solid #00A3FF",
        "cursor": "pointer"
      }
    },
    {
      "name": "Navigation Bar",
      "type": "navigation",
      "css_class": ".lumenis-nav",
      "background": "#1F2937",
      "color": "#FFFFFF",
      "properties": {
        "padding": "16px 24px",
        "display": "flex",
        "align-items": "center",
        "gap": "24px"
      }
    },
    {
      "name": "Info Box",
      "type": "container",
      "css_class": ".lumenis-info-box",
      "background": "#FFF5D0",
      "color": "#1F2937",
      "properties": {
        "padding": "16px",
        "border-radius": "8px",
        "border": "1px solid #FFE36F"
      }
    },
    {
      "name": "Warning Banner",
      "type": "alert",
      "css_class": ".lumenis-warning",
      "background": "#FFFDBD",
      "color": "#1F2937",
      "properties": {
        "padding": "16px",
        "border-radius": "8px",
        "border": "1px solid #FFF925"
      }
    },
    {
      "name": "Card",
      "type": "container",
      "css_class": ".lumenis-card",
      "background": "#FFFFFF",
      "color": "#1F2937",
      "properties": {
        "padding": "24px",
        "border-radius": "12px",
        "box-shadow": "0 4px 6px rgba(0, 0, 0, 0.1)",
        "border": "1px solid #E5E7EB"
      }
    },
    {
      "name": "Input Field",
      "type": "form",
      "css_class": ".lumenis-input",
      "background": "#FFFFFF",
      "color": "#1F2937",
      "properties": {
        "padding": "8px",
        "border-radius": "6px",
        "border": "1px solid #D1D5DB",
        "font-size": "16px"
      }
    },
    {
      "name": "Tooltip",
      "type": "overlay",
      "css_class": ".lumenis-tooltip",
      "background": "#1F2937",
      "color": "#FFFFFF",
      "properties": {
        "padding": "4px 8px",
        "border-radius": "4px",
        "font-size": "14px",
        "box-shadow": "0 2px 8px rgba(0, 0, 0, 0.15)"
      }
    },
    {
      "name": "Semantic Search Box",
      "type": "search",
      "css_class": ".lumenis-semantic-search",
      "background": "#FFFFFF",
      "color": "#1F2937",
      "properties": {
        "padding": "16px",
        "border-radius": "12px",
        "border": "2px solid #00A3FF",
        "box-shadow": "0 2px 8px rgba(0, 163, 255, 0.1)"
      }
    }
  ]
}